# ── PacketBot (Google Gemini) ─────────────────────────────────────────
# A chave é usada APENAS pelo proxy server-side em functions/api/chat.js.
# NUNCA exponha no cliente (não use o prefixo VITE_).
# No Cloudflare Pages: Settings > Variables and secrets > adicione como SECRET.
GEMINI_KEY=sua-chave-gemini-aqui

# ── Banco de dados PostgreSQL (Umami analytics) ───────────────────────
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=troque-por-senha-forte

# Umami — gere com: openssl rand -hex 32
UMAMI_APP_SECRET=troque-por-string-aleatoria-de-32-chars
